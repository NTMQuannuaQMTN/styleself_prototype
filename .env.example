# ---------------------------------------------------------------------------
# Client (Vite) — exposed to the browser. Put real values in .env.local
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Server only — the agent runtime (Vite dev middleware + /api/agent/*).
# Never exposed to the browser. Set these in .env (local) and in your host's
# environment for production (e.g. Vercel Project Settings → Environment Variables).
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
# Optional — cost-efficient tool-calling model. Defaults to gpt-4o-mini.
AI_MODEL=gpt-4o-mini

# HMAC secret for checkout order-draft / payment-authorization tokens.
# REQUIRED in production. Any long random string (e.g. `openssl rand -hex 32`).
AGENT_SIGNING_SECRET=change-me-to-a-long-random-string

# In production the agent reads SUPABASE_URL / SUPABASE_ANON_KEY (it also
# accepts the VITE_ or NEXT_PUBLIC_ prefixed names as a fallback).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
